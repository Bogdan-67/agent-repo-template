{
  "context": { "fileName": ["AGENTS.md", "GEMINI.md"] },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "name": "docs-guard-start", "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/docs_guard.py\" start --harness gemini", "timeout": 30000 } ] }
    ],
    "AfterAgent": [
      { "hooks": [ { "type": "command", "name": "docs-guard-stop", "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/docs_guard.py\" stop --harness gemini", "timeout": 60000 } ] }
    ]
  }
}
