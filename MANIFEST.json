{
  "name": "agent-repo-template",
  "version": "0.1.0",
  "source": "https://github.com/Bogdan-67/agent-repo-template",
  "_owners": {
    "template": "machinery; replaced on upgrade if unmodified (sha256 in .agents/template.lock)",
    "merge": "config shared with the user; entries are merged, never replaced",
    "seed": "starting content owned by the user after install; never replaced"
  },
  "files": {
    ".agents/bin/sync.py": "template",
    ".agents/guard.json": "merge",
    ".agents/hooks/docs_guard.py": "template",
    ".agents/init.sh": "seed",
    ".agents/skills/cold-start-test/SKILL.md": "template",
    ".agents/skills/record-decision/SKILL.md": "template",
    ".agents/skills/session-close/SKILL.md": "template",
    ".agents/skills/write-handoff/SKILL.md": "template",
    ".claude/settings.json": "merge",
    ".codex/hooks.json": "merge",
    ".gemini/settings.json": "merge",
    ".githooks/pre-commit": "template",
    ".github/hooks/docs-guard.json": "merge",
    ".github/workflows/agent-docs.yml": "template",
    ".opencode/plugins/docs-guard.ts": "template",
    "AGENTS.md": "seed",
    "CLAUDE.md": "seed",
    "GLOSSARY.md": "seed",
    "OPEN_QUESTIONS.md": "seed",
    "STATUS.md": "seed",
    "STRUCTURE.md": "seed",
    "docs/OVERVIEW.md": "seed",
    "docs/adr/0000-template.md": "template",
    "docs/adr/0001-repository-is-the-source-of-truth.md": "seed",
    "docs/adr/README.md": "seed",
    "docs/agents/README.md": "template",
    "docs/agents/cold-start-quiz.md": "seed",
    "docs/agents/docs-keeper.md": "seed",
    "docs/agents/domain.md": "seed",
    "docs/agents/implementer.md": "seed",
    "docs/agents/reviewer.md": "seed",
    "docs/handoff/TEMPLATE.md": "template",
    "docs/journal/README.md": "template",
    "docs/state/README.md": "template",
    "docs/state/tasks.json": "seed"
  }
}
